# Copy to .env for local development and replace every placeholder.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LAB_API_KEY=replace-with-a-long-random-secret

# SQLite database path. The parent directory is created automatically.
LAB_DB_PATH=./data/review.sqlite3

# Root directory the /api/v1/scan endpoint may read. Defaults to the project
# root when unset. Never point this at /, /etc, or a directory containing secrets.
LAB_SCAN_ROOT=.

# Interactive OpenAPI/Swagger documentation is disabled by default.
LAB_ENABLE_DOCS=false

# Maximum number of Python files a single scan may inspect.
LAB_MAX_SCAN_FILES=2000
